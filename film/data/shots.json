{
 "_doc": "ショットリスト。build_edl.py / pexels_fetch.py / ambience.py が参照する。dur は目安秒数（章の実尺に合わせて比例配分される）。kind: observation=現在の自然の観察映像 / metaphor=現代の映像による比喩（古代の記録ではない）/ reconstruction=図解・再現。queries は Pexels 検索語（英語）。",
 "chapters": [
  {
   "id": 1,
   "name": "始まり",
   "en": "Beginning",
   "emotion": "好奇心",
   "intent": "暗闇、熱、岩、海。静けさから、何かが生まれようとする気配へ。最初の5秒で引き込む。"
  },
  {
   "id": 2,
   "name": "生命の芽生え",
   "en": "First Life",
   "emotion": "好奇心",
   "intent": "水中の光、熱水、微生物。小さな動きが大きな物語の始まりであること。"
  },
  {
   "id": 3,
   "name": "広がる生命",
   "en": "Branching Out",
   "emotion": "驚き",
   "intent": "海の生物から陸の植物・動物へ。多様化と適応。河川→葉脈→翅脈の枝分かれで『進歩の一本道ではなく枝分かれ』を示す。"
  },
  {
   "id": 4,
   "name": "生命の交響曲",
   "en": "Symphony",
   "emotion": "高揚",
   "intent": "森、昆虫、鳥、群れ、大型動物。速い編集の中に長いショットを残す。波→魚群→鳥群の運動の呼応。"
  },
  {
   "id": 5,
   "name": "すべてがつながる",
   "en": "Connected",
   "emotion": "静かな感動",
   "intent": "曲の頂点（半音ずつ上がる盛り上がり）に合わせ、雨→水→土→菌→動物→滝と速く連ねる。曲が途切れる瞬間に滝から水滴へ。"
  },
  {
   "id": 6,
   "name": "余韻",
   "en": "Afterglow",
   "emotion": "静かな感動",
   "intent": "曲が途切れた後の静けさ。水滴、芽、若葉。短い言葉とタイトル。"
  }
 ],
