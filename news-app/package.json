{
  "name": "orchard",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "expo": "~58.0.23",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lefthook": "^2.2.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "shot": "node scripts/shot.mjs",
    "preflight": "node scripts/preflight-build.mjs",
    "build:dev": "eas build --profile development",
    "build:ios": "npm run preflight && eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "refs": "node scripts/gen-ref-images.mjs",
    "postinstall": "node scripts/gen-ref-images.mjs",
    "prestart": "node scripts/gen-ref-images.mjs",
    "preverify": "node scripts/gen-ref-images.mjs",
    "preshot": "node scripts/gen-ref-images.mjs",
    "live": "node scripts/gen-ref-images.mjs && expo start --port 8093",
    "live:tunnel": "node scripts/gen-ref-images.mjs && expo start --port 8093 --tunnel",
    "live:web": "node scripts/gen-ref-images.mjs && expo start --port 8093 --web"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
