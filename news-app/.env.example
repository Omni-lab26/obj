# 使う鍵だけ残して、.env にコピーして値を入れる。.env はコミットしない。
#
# 注意：EXPO_PUBLIC_ で始まる値はアプリに埋め込まれ、誰でも読める。
#       公開してよい鍵（Supabase の anon key など）だけを入れる。
#       秘密の鍵（service role key、Webhook の秘密など）はサーバー側（Edge Functions の secrets 等）に置く。
#
# どの値もないときは、アプリはデモモード（デモデータ）で動く作りにする。

# --- バックエンド（例：Supabase） ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- 課金（例：RevenueCat。公開してよい SDK キー） ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# --- エラー収集（例：Sentry） ---
EXPO_PUBLIC_SENTRY_DSN=
